{
  "name": "@harmony/discord-bridge",
  "version": "2.0.0",
  "description": "Discord ↔ Harmony bridge (bot-gateway client)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "keywords": [
    "harmony",
    "discord",
    "bridge",
    "bot"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.3.1",
    "ws": "^8.16.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
